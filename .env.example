# App
APP_NAME=BiteBuddy API
APP_VERSION=0.1.0
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_JWT_SECRET=

# Gemini AI (Google AI Studio)
GEMINI_API_KEY=
GEMINI_FOOD_MODEL=gemini-3.5-flash
GEMINI_MEDICINE_MODEL=gemini-3.5-flash
GEMINI_NUTRITION_MODEL=gemini-3.5-flash
GEMINI_DOCTOR_MODEL=gemini-3.5-flash

# OpenRouter Qwen fallback (used only when Gemini is unavailable)
QWEN_FALLBACK=
QWEN_FALLBACK_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

